# ==============================================================================
# NWIS (Nearby Wells Intelligence System) - Environment Configuration
# ==============================================================================
# Copy this file to .env before starting:
# Windows PowerShell: Copy-Item .env.example .env
# Linux/macOS:        cp .env.example .env
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=nwis_db
POSTGRES_USER=nwis_user
POSTGRES_PASSWORD=nwis_password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Database Connection URL (for local backend development)
DATABASE_URL=postgresql://nwis_user:nwis_password@localhost:5432/nwis_db

# Backend API Configuration
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Frontend Configuration
VITE_API_URL=http://localhost:8000
